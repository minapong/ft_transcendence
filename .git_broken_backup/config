[core]
	repositoryformatversion = 0
	filemode = true
	bare = false
	logallrefupdates = true
[remote "origin"]
	url = git@github.com:minapong/ft_transcendence.git
	fetch = +refs/heads/*:refs/remotes/origin/*
[branch "main"]
	remote = origin
	merge = refs/heads/main
	vscode-merge-base = origin/main
[branch "SPA-reactor"]
	remote = origin
	merge = refs/heads/SPA-reactor
	vscode-merge-base = origin/SPA-reactor
[branch "matchmaking_addition"]
	remote = origin
	merge = refs/heads/matchmaking_addition
	vscode-merge-base = origin/matchmaking_addition
