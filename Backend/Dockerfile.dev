# # CMD ["npm", "run", "dev"]

FROM node:20-bullseye-slim

WORKDIR /app

# Install system packages needed for sqlite and building native modules
RUN apt-get update && \
    apt-get install -y sqlite3 build-essential python3 && \
    apt-get clean \
    && rm -rf /var/lib/apt/lists/*

# Copy package manifests first to leverage Docker cache
COPY package*.json ./

COPY prisma ./prisma

# COPY prisma.config.js . 

COPY .env .env
# Install node modules (pulls prisma if package.json includes it)
RUN npm install

RUN npx prisma generate
# Copy remaining source
COPY . .

EXPOSE 3000

# On container start: run migrations, start dev server
CMD ["sh", "-c", "npm run migrate && npm run dev"]

