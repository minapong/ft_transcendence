FROM node:20-bullseye-slim

WORKDIR /app

# System deps
RUN apt-get update && \
    apt-get install -y sqlite3 build-essential python3 && \
    apt-get clean && rm -rf /var/lib/apt/lists/*

# Copy package files first
COPY package*.json ./

# Install deps
RUN npm install

# Copy EVERYTHING (including prisma, ts, src)
COPY . .

# Generate Prisma Client AFTER all files exist
RUN npx prisma generate

EXPOSE 3000

# Runtime
CMD ["sh", "-c", "npx prisma generate && npm run migrate && npm run dev"]